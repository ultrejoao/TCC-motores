# Sinais brutos do KAIST (~7,6 GB) - baixar do Mendeley, ver README
ml/data/raw/

# Dados derivados (regeneraveis pelos scripts)
ml/data/interim/*.parquet
ml/data/interim/*.csv

# Os modelos treinados (ml/artifacts/*.joblib) SAO versionados: regenera-los
# exige os 7,6 GB de dados brutos, e sem eles um clone nao consegue diagnosticar.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Arquivos temporarios do Office/Windows
~$*

# Segredos: nunca versionar
.env
*.env
!.env.example

# Arquivos brutos enviados pelos tecnicos
backend/uploads/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# As amostras de demonstracao (ml/data/demo_samples/*.csv) SAO versionadas:
# regenera-las tambem exige os dados brutos.

# Backups locais do banco e dos sinais enviados (nunca versionar)
backups/
